%% codepoints.dg -- Å-machine character set and status bar exercise.
%%
%% Several things are being exercised here which are invisible to the
%% aambox and node frontends and have to be eyeballed on real hardware (or in
%% an emulator):
%%
%%   * Word wrapping behavior -- different on every implementation.
%%
%%   * Every codepoint the 8-bit backends claim to handle.  The C64 draws
%%     these from a custom font; the Apple II has no custom font in text mode
%%     and transliterates them to ASCII through the table at the bottom of
%%     src/6502/a2_frontend.s.  Page 6 is a negative control: those codepoints
%%     are in neither backend and should come out as the interpreter's
%%     "unknown character" glyph ('?' on the Apple II, a solid box on the C64).
%%
%%   * Status-bar edge cases: extended characters in row 0 (which goes
%%     through the buffered wrapbuf/io_scommit path instead of cout), a row 0
%%     too wide for the screen (the buffered path truncates instead of
%%     wrapping), and a row 1+ too wide for the screen (the cout path wraps
%%     it -- watch where the overflow lands).
%%
%%   * A wrap-buffer aliasing probe (press W): leaves a word pending in the
%%     middle of a text line and redraws the status bar before the word is
%%     flushed.  Row 0 of the status bar shares its buffer with the pending
%%     word, so a stale or doubled word here means aliasing trouble.
%%
%% Page 8    fold straddling: two-character expansions split across a hard
%%           fold must lose nothing (39-padded lines target 40 columns,
%%           79-padded lines target 80), overlong words made of expanding
%%           characters must hard-fold cleanly, transliterated spaces
%%           landing exactly on the fold must not vanish, and lines and
%%           paragraphs that fill the screen exactly -- notably right after
%%           an em dash expansion -- must not leave a spurious blank line
%%           (the firmware wraps by itself after the last column)
%% Page 9    negative control 2, consecutive unknown codepoints: each must
%%           become its own unknown-character glyph
%% Page 10   [MORE] accounting across a line-input prompt: the only page that
%%           reads a line instead of a key, filling the window to exactly one
%%           line short of the pagination limit first
%% Page 11   every declaration engine.s's CSS parser understands.  Its
%%           keyword table (csskeywords, src/6502/engine.s) holds exactly
%%           eight -- width, height, float, font-style, font-weight,
%%           font-family, margin-top, margin-bottom -- and skips anything
%%           else in silence.  Only the two margin keywords are visible to
%%           the automated backends; width/float/height live in the status
%%           bar, and the three font keywords only reach io_mstyle, which
%%           aambox and the node frontend both stub out.
%%
%%   * A status bar whose height changes at run time.  The Å-machine reads the
%%     height of the top status area straight out of the style class, so a
%%     variable-height bar means a set of classes -- one per height -- picked
%%     at run time.  ('status bar $ with height $' is a Z-machine affordance
%%     and is ignored by this backend.)  Rows 2 and up take a different code
%%     path in the Apple II frontend than row 0 does: row 0 is buffered in
%%     wrapbuf and committed by io_scommit, while the rest go straight to the
%%     screen through cout.  Cycling the height exercises both, plus the
%%     shrink case, where the bar has to give rows back to the text window.

(story title)	Codepoint Exercise
(story author)	Å-machine test suite
(story noun)	Character set and status bar exercise
(story release 1)

(story ifid)
		9C4F2E17-6B0A-4D3C-8E5F-1A72B9D0C384

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Style classes

%% One class per status bar height.  Heights above 19 are clamped by the 6502
%% engine, and a height of 0 is treated as 1.

(style class @status1)
	height: 1em;

(style class @status2)
	height: 2em;

(style class @status3)
	height: 3em;

(style class @status4)
	height: 4em;

%% Height edge cases, on keys 0 and 5-7.  op_status (engine.s, the
%% STY_HEIGHT/STYF_RELH block) turns 0 and any relative height into 1 and
%% clamps anything from 20 up to 19, so between them these four probe both
%% ends of the clamp and the units css_abs_rel accepts for an absolute
%% value ('em', 'en' and 'ch'; '%' is what makes a value relative, and
%% anything else parses as absolute 0).  (bar rows) below records what each
%% one should actually come out as.

(style class @status0)
	height: 0em;

(style class @status5)
	height: 50%;

(style class @status6)
	height: 2en;

(style class @status7)
	height: 30em;

%% Floats.  width and float only reach the layout code inside a status area
%% -- op_en_lv_div tests stflag before it looks at STY_FLAGS at all -- so all
%% three float classes live in the bar.  @leftcol is the only STYF_FLOATL
%% user in the suite, and @pctcol is the only relative width, resolved
%% against the full bar width at run time; both are drawn only on page 10,
%% nested inside the same bar as @rightcol so the float stack has to push and
%% pop stleft/stendx/stfullw more than once.

(style class @rightcol)
	float: right;
	width: 10ch;

(style class @leftcol)
	float: left;
	width: 12ch;

(style class @pctcol)
	float: right;
	width: 25%;

%% Text styling.  engine.s folds font-style/font-weight/font-family into the
%% STY_STYON/STY_STYOFF bitmasks that unstyle hands to io_mstyle -- italic
%% and oblique both set bit 2, bold sets bit 1, and font-family sets bit 3
%% only if the value contains the word 'monospace'.  'normal' is the only
%% value that goes into STY_STYOFF, which is what makes the nested cases on
%% page 10 worth having: the inner class has to clear one bit and leave the
%% other alone.
%%
%% None of this is visible to the automated backends (aambox and the node
%% frontend both stub io_mstyle), and the Apple II renders reverse only, so
%% these are a C64 inspection -- there io_mstyle maps bits 1-2 onto its
%% palette table.

(style class @italic)
	font-style: italic;

(style class @oblique)
	font-style: oblique;

(style class @roman)
	font-style: normal;

(style class @bold)
	font-weight: bold;

(style class @unbold)
	font-weight: normal;

(style class @bolditalic)
	font-weight: bold;
	font-style: italic;

(style class @fixed)
	font-family: monospace;

%% A font-family that is not monospace must set no bit at all.  The name is
%% deliberately one that contains neither 'm' nor a substring of 'monospace',
%% since the matcher scans for the word rather than comparing the whole value.

(style class @propfont)
	font-family: Georgia, serif;

%% Margins are the one part of page 10 the automated backends do render, as
%% blank lines.  The two engines get there by different routes: the node
%% frontend reads margin-top/margin-bottom out of the raw CSS itself
%% (parse_em, nodefrontend.js), while engine.s parses them into
%% STY_MTOP/STY_MBOTTOM.  They do not agree on units -- parse_em's regexp
%% takes 'em' only, css_abs_rel also takes 'en' and 'ch' -- so @marginch is a
%% deliberate divergence between codepoints.js.gold and codepoints.6502.gold,
%% and the one case here where the two gold files must NOT match.  A relative
%% margin is rejected outright by engine.s (css_abs_rel returns carry set and
%% the margin branch drops the value), and by parse_em for want of an 'em'.

(style class @margins)
	margin-top: 2em;
	margin-bottom: 3em;

(style class @marginch)
	margin-top: 2ch;
	margin-bottom: 2en;

(style class @marginpct)
	margin-top: 50%;
	margin-bottom: 50%;

%% Negative control for the parser.  Not one of these is in csskeywords, so
%% each must be skipped without disturbing the declarations around it -- the
%% trailing margin-bottom is the canary, since it is the thing that stops
%% working if an unknown declaration ever desynchronises the parse.  Note
%% that text-decoration is how the Dialog compiler spells (reverse) in a
%% class, so reverse-as-CSS is unimplemented rather than merely untested.

(style class @ignoredcss)
	color: red;
	background-color: black;
	text-decoration: reverse;
	text-align: center;
	font-size: 200%;
	margin-bottom: 1em;

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% State

(global variable (current page 1))
(global variable (bar height 1))

(last page 11)

%% Nudges page 10's line count for screens that are not 24 rows.  It is an
%% unsigned 0-8 offset -- 4 is the 24-row Apple II value -- because the count
%% feeds a countdown recursion that must never be handed a negative.
(global variable (probe pad 4))

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The status bar

%% Each row is deliberately made of characters that need transliterating, so
%% that a too-short bar (text missing) and a too-tall bar (leftover inverse
%% rows) are both obvious at a glance.

(draw bar)
	(bar height $H)
	(draw bar $H)

(draw bar 1)
	(status bar @status1) (bar contents)

(draw bar 2)
	(status bar @status2) (bar contents)

(draw bar 3)
	(status bar @status3) (bar contents)

(draw bar 4)
	(status bar @status4) (bar contents)

(draw bar 0)
	(status bar @status0) (bar contents)

(draw bar 5)
	(status bar @status5) (bar contents)

(draw bar 6)
	(status bar @status6) (bar contents)

(draw bar 7)
	(status bar @status7) (bar contents)

%% How many rows each class should actually produce once engine.s has clamped
%% the parsed height.  The bar draws its rows from this rather than from the
%% key that was pressed, so a bar that comes out the wrong height leaves
%% either blank rows at the bottom or text spilling past it -- both obvious.

(bar rows 0 1)		%% height: 0em  -- zero becomes 1
(bar rows 1 1)
(bar rows 2 2)
(bar rows 3 3)
(bar rows 4 4)
(bar rows 5 1)		%% height: 50%  -- relative becomes 1
(bar rows 6 2)		%% height: 2en  -- 'en' is an absolute unit
(bar rows 7 19)		%% height: 30em -- clamped down to 19

%% Row 0 is deliberately given a long tail of expanding characters: it goes
%% through the buffered wrapbuf path, which truncates at the screen width
%% instead of wrapping, so both the transliteration and the truncation point
%% (possibly splitting an expansion) are under test on every page.
(bar contents)
	(bar height $H) (bar rows $H $N)
	%% Page 11 adds the other two floats, so that bar has a left float and
	%% two nested right floats to lay out instead of just the one.
	(if) (current page 10) (then)
		(div @leftcol) { L 12ch }
		(div @pctcol) { R 25% }
	(endif)
	(div @rightcol) {
		h= $H/$N
	}
	(current page $P) (last page $L)
	Codepoints $P/$L \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014} \x{00E9}\x{00DF}\x{2014}
	(if) ($N > 1) (then)
		(line) 2 \x{00C4}\x{00E9}\x{00EE}\x{00F6}\x{00FC} \x{00C6}\x{0152}\x{00DF}
	(endif)
	(if) ($N > 2) (then)
		(line) 3 \x{2018}q\x{2019} \x{201C}q\x{201D} \x{201E}q\x{201D} \x{2039}q\x{203A}
	(endif)
	(if) ($N > 4) (then)
		(fill bar rows $N from 5)
	(endif)
	(if) ($N > 3) (then)
		(line) 4 \x{2022} \x{2013} \x{2014} \x{2026} \x{20AC} \x{00AB}\x{00BB} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF} \x{00E9}\x{00DF}
	(endif)

%% Rows 5 and up only ever appear under the 30em class, whose whole point is
%% the clamp -- so they are numbered, and the last one has to read 19.

(fill bar rows $N from $I)
	($I > $N)

(fill bar rows $N from $I)
	(line) $I \x{00E9}\x{00DF}\x{2014} filler
	($I plus 1 into $Next)
	(fill bar rows $N from $Next)

